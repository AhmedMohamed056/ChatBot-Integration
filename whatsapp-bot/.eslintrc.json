{
  "env": {
    "node": true,
    "commonjs": true,
    "es2022": true
  },
  "extends": ["eslint:recommended", "plugin:import/recommended", "prettier"],
  "plugins": ["import"],
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "commonjs"
  },
  "rules": {
    "no-console": "off",
    "no-unused-vars": "off",
    "import/no-unresolved": "off"
  }
}
